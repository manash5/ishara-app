<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: Ishara teal with no icon (no Flutter logo).
         Flutter's own Splash (01) runs the Danphe animation right after. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ishara_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ishara_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
